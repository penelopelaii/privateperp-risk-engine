# Base URL of the FastAPI backend, with no trailing slash.
#
# Local development: copy this file to .env.local and leave the default.
# Vercel: set NEXT_PUBLIC_API_BASE_URL in Project Settings -> Environment
# Variables to the deployed backend URL, e.g. https://your-api.onrender.com
#
# This is baked into the client bundle at build time and is therefore public.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
